# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Only ':free' models are accepted (validated in config.py).
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
LLM_FALLBACK_MODELS=google/gemma-4-31b-it:free,poolside/laguna-s-2.1:free
LLM_TIMEOUT_S=45
LLM_MAX_ATTEMPTS=3

# Retrieval: similarity | mmr | hybrid
SEARCH_TYPE=similarity
TOP_K=4
RERANK=false

CHUNK_SIZE=800
CHUNK_OVERLAP=120
